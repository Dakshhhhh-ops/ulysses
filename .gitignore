# Run-time output: databases, keys, captured responses, reports. Regenerated by scripts.
.run/
var/
*.db
*.sqlite3

# Signer private keys never go in git
keys/
*.key

# Local configuration with secrets
.env
.env.*
!.env.example
# Written by `ulysses init`; holds the agent token
ulysses.mcp.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Front end: the built bundle and fonts ARE committed (the service needs no Node);
# node_modules and the developer-only fixture server are not.
!src/ulysses/service/static/dist/
web/node_modules/
web/dev/
.design-refs/

# Written by `ulysses calibrate summarise` next to a shipped trace
data/live.md

# A scripted mock run never belongs next to the real model transcripts
examples/llm_agent/transcripts/*.mock.jsonl

# local editor and agent settings
.claude/
