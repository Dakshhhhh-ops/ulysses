# Copy to .env and fill in. .env is git-ignored.

# Flagsmith: Cloud (https://api.flagsmith.com) or your self-hosted URL.
FLAGSMITH_API_URL=http://localhost:8000
# Organisation admin API key. Only the contract service reads this; the agent never sees it.
FLAGSMITH_ADMIN_KEY=
FLAGSMITH_ORGANISATION_ID=
# Project to create the ulysses-* environments in (default: the organisation's first project).
FLAGSMITH_PROJECT_ID=

# The bearer token the MCP extension uses to talk to the contract service (read and propose only).
# Required. `ulysses init` writes a random one; the service refuses to start without it.
ULYSSES_AGENT_TOKEN=
# Where the signing surface and decision cards are served.
ULYSSES_PUBLIC_URL=http://127.0.0.1:8200
# Optional: Slack incoming-webhook URL for decision cards.
ULYSSES_SLACK_WEBHOOK=
# The HMAC secret Flagsmith signs each audit-log delivery with (X-Flagsmith-Signature).
# Required. `ulysses init` writes a random one. Without it `ulysses lab setup` will not register the webhook
# and the service refuses audit-webhook posts. Left empty here so no shared example value can become a real secret.
ULYSSES_WEBHOOK_SECRET=
# Where Flagsmith (in Docker) reaches the service's audit webhook; `ulysses lab setup` registers it.
# Self-hosted Flagsmith must list host.docker.internal in SSRF_ALLOWED_HOSTS. Flagsmith Cloud needs a public URL.
ULYSSES_WEBHOOK_URL=http://host.docker.internal:8200/webhooks/flagsmith
